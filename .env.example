# ------------------------------------------------------------------------------
# AI-Vibe-Trader 환경 설정 예시 (.env.example)
# ------------------------------------------------------------------------------

# 1. 증권사 API 설정
BROKER_TYPE=KIS # KIS 또는 KIWOOM
KIS_APPKEY=your_kis_appkey
KIS_SECRET=your_kis_secret
KIS_CANO=your_kis_cano_8_digits
KIS_ACNT_PRDT_CD=01
KIS_IS_VIRTUAL=TRUE # TRUE: 모의투자, FALSE: 실전투자

# 2. Google Cloud Vertex AI 설정 (AI Studio 대체)
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./vertex_key.json

# 3. AI 및 멀티 LLM 설정
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_MODEL=gemini-2.5-pro
GEMINI_MAX_CPS=1.0

# 4. Groq 설정 (선택 사항)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_SECONDARY_MODEL=llama-3.1-8b-instant
GROQ_MAX_CPS=0.5

# 5. Fail-over 우선순위 설정 (쉼표로 구분)
LLM_SEQUENCE=GEMINI:gemini-2.5-flash,GROQ:llama-3.1-70b-versatile

# 6. 트레이딩 파라미터
TAKE_PROFIT_THRESHOLD=5.0
STOP_LOSS_THRESHOLD=-5.0
AVERAGE_DOWN_AMOUNT=500000
MIN_LOSS_TO_BUY=-3.0
MAX_STOCK_COUNT=8
